project Tictactoe is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Main use ("tictactoe.adb");

   package Builder is
      for Switches ("ada") use ("-g");
   end Builder;

   package Linker is
      for Switches ("ada") use ("-g");
   end Linker;

   package Compiler is
      for Switches ("ada") use ("-g");
   end Compiler;

end Tictactoe;

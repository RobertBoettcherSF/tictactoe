project Tictactoe is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Main use ("tictactoe.adb");
   for Create_Missing_Dirs use ("True");

   package Linker is
      for Switches ("ada") use ("-g");
   end Linker;

   package Compiler is
      for Switches ("ada") use ("-g");
   end Compiler;

end Tictactoe;
